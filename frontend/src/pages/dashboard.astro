<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Dashboard</title>
	</head>
	<body>
		<h1>Dashboard</h1>
		<p id="email"></p>
		<button id="sign-out">Sign out</button>
		<button id="call-api">Call protected API</button>
		<pre id="api-result"></pre>

		<hr />

		<p id="gmail-status">Checking Gmail connection…</p>
		<p id="gmail-message" style="display: none;"></p>
		<button id="gmail-connect" style="display: none;">Connect Gmail</button>
		<button id="gmail-fetch" style="display: none;">Fetch Gmail messages</button>
		<pre id="gmail-fetch-result"></pre>

		<hr />
		<label for="extract-message-id">Message ID:</label>
		<input id="extract-message-id" type="text" placeholder="paste a messageId from above" style="width: 320px;" />
		<label for="extract-part-id">Part ID (optional):</label>
		<input id="extract-part-id" type="text" placeholder="optional" style="width: 100px;" />
		<button id="extract-btn">Extract invoice data</button>
		<pre id="extract-result"></pre>

		<hr />
		<button id="scan-btn" style="display: none;">Scan &amp; save invoices</button>
		<pre id="scan-result"></pre>

		<script>
			import { supabase, API_BASE_URL } from '../lib/supabase';

			const {
				data: { session },
			} = await supabase.auth.getSession();

			if (!session) {
				location.replace('/login');
			} else {
				document.getElementById('email')!.textContent = `Signed in as ${session.user.email}`;

				document.getElementById('sign-out')!.addEventListener('click', async () => {
					await supabase.auth.signOut();
					location.replace('/login');
				});

				document.getElementById('call-api')!.addEventListener('click', async () => {
					const resultEl = document.getElementById('api-result')!;
					resultEl.textContent = 'Loading…';
					try {
						const res = await fetch(`${API_BASE_URL}/api/me`, {
							headers: { Authorization: `Bearer ${session.access_token}` },
						});
						const body = await res.json();
						resultEl.textContent = `${res.status}\n${JSON.stringify(body, null, 2)}`;
					} catch (err) {
						resultEl.textContent = `Request failed: ${(err as Error).message}`;
					}
				});

				// Gmail connection status + connect flow
				const gmailStatusEl = document.getElementById('gmail-status')!;
				const gmailMessageEl = document.getElementById('gmail-message')!;
				const gmailConnectBtn = document.getElementById('gmail-connect')!;
				const gmailFetchBtn = document.getElementById('gmail-fetch')!;
				const scanBtn = document.getElementById('scan-btn')!;

				const gmailParam = new URLSearchParams(location.search).get('gmail');
				if (gmailParam) {
					const messages: Record<string, string> = {
						connected: 'Gmail connected successfully.',
						denied: 'Gmail connection was cancelled.',
						error: 'Gmail connection failed. Please try again.',
					};
					gmailMessageEl.textContent = messages[gmailParam] ?? '';
					gmailMessageEl.style.display = 'block';
					history.replaceState(null, '', location.pathname);
				}

				async function refreshGmailStatus() {
					try {
						const res = await fetch(`${API_BASE_URL}/api/gmail/status`, {
							headers: { Authorization: `Bearer ${session.access_token}` },
						});
						const body = await res.json();
						if (body.connected) {
							gmailStatusEl.textContent = `Gmail connected (since ${new Date(body.connectedAt).toLocaleString()})`;
							gmailConnectBtn.style.display = 'none';
							gmailFetchBtn.style.display = 'inline-block';
							scanBtn.style.display = 'inline-block';
						} else {
							gmailStatusEl.textContent = 'Gmail not connected.';
							gmailConnectBtn.style.display = 'inline-block';
							gmailFetchBtn.style.display = 'none';
							scanBtn.style.display = 'none';
						}
					} catch (err) {
						gmailStatusEl.textContent = `Failed to load Gmail status: ${(err as Error).message}`;
					}
				}

				gmailConnectBtn.addEventListener('click', async () => {
					const res = await fetch(`${API_BASE_URL}/api/gmail/connect`, {
						headers: { Authorization: `Bearer ${session.access_token}` },
					});
					const body = await res.json();
					if (body.url) location.href = body.url;
				});

				gmailFetchBtn.addEventListener('click', async () => {
					const resultEl = document.getElementById('gmail-fetch-result')!;
					resultEl.textContent = 'Loading…';
					try {
						const res = await fetch(`${API_BASE_URL}/api/gmail/messages?months=6`, {
							headers: { Authorization: `Bearer ${session.access_token}` },
						});
						const body = await res.json();
						resultEl.textContent = `${res.status}\n${JSON.stringify(body, null, 2)}`;
					} catch (err) {
						resultEl.textContent = `Request failed: ${(err as Error).message}`;
					}
				});

				document.getElementById('extract-btn')!.addEventListener('click', async () => {
					const resultEl = document.getElementById('extract-result')!;
					const messageId = (document.getElementById('extract-message-id') as HTMLInputElement).value.trim();
					const partId = (document.getElementById('extract-part-id') as HTMLInputElement).value.trim();
					if (!messageId) {
						resultEl.textContent = 'Message ID is required.';
						return;
					}
					resultEl.textContent = 'Loading… (this calls the Claude API and can take a few seconds)';
					try {
						const res = await fetch(`${API_BASE_URL}/api/gmail/extract`, {
							method: 'POST',
							headers: {
								Authorization: `Bearer ${session.access_token}`,
								'Content-Type': 'application/json',
							},
							body: JSON.stringify(partId ? { messageId, partId } : { messageId }),
						});
						const body = await res.json();
						resultEl.textContent = `${res.status}\n${JSON.stringify(body, null, 2)}`;
					} catch (err) {
						resultEl.textContent = `Request failed: ${(err as Error).message}`;
					}
				});

				scanBtn.addEventListener('click', async () => {
					const resultEl = document.getElementById('scan-result')!;
					resultEl.textContent = 'Loading… (this scans, extracts, and saves — can take a while)';
					try {
						const res = await fetch(`${API_BASE_URL}/api/gmail/scan`, {
							method: 'POST',
							headers: {
								Authorization: `Bearer ${session.access_token}`,
								'Content-Type': 'application/json',
							},
							body: JSON.stringify({}),
						});
						const body = await res.json();
						resultEl.textContent = `${res.status}\n${JSON.stringify(body, null, 2)}`;
					} catch (err) {
						resultEl.textContent = `Request failed: ${(err as Error).message}`;
					}
				});

				await refreshGmailStatus();
			}
		</script>
	</body>
</html>
