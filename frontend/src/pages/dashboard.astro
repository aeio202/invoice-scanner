---
import '../styles/theme.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Invoice Scanner</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,900&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="topbar">
			<h1 class="logo">STACKLY<span class="dot">.</span></h1>
			<div class="topbar-right">
				<span id="user-email" class="muted"></span>
				<button id="sign-out-btn" class="btn btn-ghost">Sign out</button>
			</div>
		</header>

		<section id="gmail-panel" class="panel panel-feature gmail-panel">
			<h2 class="gmail-heading">Connect your Gmail to get started</h2>
			<div class="gmail-row">
				<div class="gmail-status">
					<span id="gmail-status-dot" class="status-dot"></span>
					<span id="gmail-status-text">Checking Gmail connection…</span>
				</div>
				<div class="gmail-actions">
					<button id="gmail-connect-btn" class="btn btn-primary" style="display: none;">Connect Gmail</button>
					<button id="scan-btn" class="btn btn-primary" style="display: none;">Scan &amp; save invoices</button>
				</div>
			</div>
			<p id="gmail-message" class="banner" style="display: none;"></p>
			<p id="scan-summary" class="scan-summary" style="display: none;"></p>
		</section>

		<section class="panel panel-quiet">
			<h2>Accountant email</h2>
			<p class="muted">Confirmed invoices for each month are forwarded here automatically. Leave blank to disable forwarding.</p>
			<div class="settings-row">
				<input id="accountant-email-input" type="email" class="text-input" placeholder="accountant@example.com" />
				<button id="accountant-email-save-btn" class="btn btn-primary">Save</button>
			</div>
			<p id="accountant-email-message" class="banner" style="display: none;"></p>

			<div id="forward-now-row" class="settings-row forward-now-row" style="display: none;">
				<input id="forward-period-input" type="month" class="text-input forward-period-input" />
				<button id="forward-now-btn" class="btn btn-ghost">Forward now</button>
			</div>
			<p id="forward-now-message" class="banner" style="display: none;"></p>
		</section>

		<section class="panel">
			<h2>Total spend</h2>
			<div id="totals-currency" class="stat-tiles"></div>
			<h3>By month</h3>
			<ul id="totals-month" class="month-list"></ul>
		</section>

		<section class="panel">
			<h2>Invoices</h2>
			<div class="invoices-toolbar">
				<div id="month-chips" class="month-chips"></div>
				<input id="vendor-search" type="search" class="text-input search-input" placeholder="Search vendor…" />
			</div>
			<p id="invoices-summary" class="muted mono-caption"></p>
			<p id="invoices-empty" class="muted" style="display: none;">No invoices yet — click "Scan &amp; save invoices" to get started.</p>
			<table id="invoices-table" class="invoices-table">
				<thead>
					<tr>
						<th data-sort="vendor" class="sortable">Vendor</th>
						<th data-sort="amount" class="sortable">Amount</th>
						<th data-sort="invoice_date" class="sortable">Date</th>
						<th>Status</th>
						<th></th>
					</tr>
				</thead>
				<tbody id="invoices-tbody"></tbody>
			</table>
		</section>

		<style is:global>
			body {
				line-height: 1.5;
				padding-bottom: 3rem;
			}

			.topbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				max-width: 960px;
				margin: 0 auto;
				padding: 1.5rem 1.5rem 1rem;
			}

			.topbar-right {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.panel-feature {
				border: 2px solid var(--red);
				padding: 1.75rem 2rem;
				transition: padding 200ms var(--ease), border-width 200ms var(--ease);
			}

			.gmail-heading {
				margin: 0 0 1.25rem;
			}

			.panel-feature.is-connected {
				border: 1px solid var(--rule);
				padding: 1rem 1.5rem;
			}

			.panel-feature.is-connected .gmail-heading {
				display: none;
			}

			/* Full .panel weight (background, border, padding) — only the heading
			   gets a distinct treatment, so this section doesn't look identical
			   to Gmail/Total spend/Invoices but still reads as a real feature. */
			.panel-quiet h2 {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--ink-soft);
			}

			.gmail-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.75rem;
			}

			.gmail-status {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.status-dot {
				width: 0.6rem;
				height: 0.6rem;
				border-radius: 50%;
				background: var(--ink-soft);
				display: inline-block;
			}

			.status-dot.connected {
				background: var(--red);
			}

			.scan-summary {
				margin-top: 0.75rem;
				padding: 0.5rem 0.75rem;
				background: var(--paper-raised);
				border: 1px solid var(--rule);
				color: var(--ink);
				font-size: 0.9rem;
			}

			.scan-summary.has-errors {
				background: var(--red-soft);
				border-color: var(--red);
				color: var(--red);
			}

			.stat-tiles {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}

			.stat-tile {
				padding: 0.75rem 1rem;
				background: var(--paper-raised);
				border: 1px solid var(--rule);
				min-width: 140px;
			}

			.stat-tile .currency {
				display: block;
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--ink-soft);
				text-transform: uppercase;
				letter-spacing: 0.06em;
			}

			.stat-tile .amount {
				display: block;
				font-family: var(--font-mono);
				font-size: 1.35rem;
				margin-top: 0.15rem;
				color: var(--ink);
			}

			.month-list {
				list-style: none;
				margin: 0;
				padding: 0;
				font-size: 0.9rem;
			}

			.month-list li {
				display: flex;
				gap: 0.75rem;
				padding: 0.25rem 0;
				border-bottom: 1px solid var(--rule);
			}

			.month-list li:last-child {
				border-bottom: none;
			}

			.month-list .month-label {
				font-family: var(--font-mono);
				font-weight: 500;
				min-width: 5rem;
			}

			.month-list .month-amounts {
				font-family: var(--font-mono);
				color: var(--ink-soft);
			}

			.invoices-toolbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 0.75rem;
			}

			.month-chips {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}

			.month-chip {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				padding: 0.35rem 0.6rem;
				border: 1px solid var(--rule);
				background: transparent;
				color: var(--ink-soft);
				cursor: pointer;
				transition: border-color 150ms var(--ease), color 150ms var(--ease), background 150ms var(--ease);
			}

			.month-chip:hover {
				border-color: var(--red);
				color: var(--red);
			}

			.month-chip.active {
				border-color: var(--red);
				color: var(--red);
				background: var(--red-soft);
				font-weight: 600;
			}

			.search-input {
				min-width: 200px;
				max-width: 240px;
				flex: 0 1 auto;
			}

			.mono-caption {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				letter-spacing: 0.03em;
				margin: 0 0 0.75rem;
			}

			.invoices-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.9rem;
			}

			.invoices-table th {
				text-align: left;
				font-family: var(--font-mono);
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--ink-soft);
				padding: 0.4rem 0.5rem;
				border-bottom: 1px solid var(--rule);
			}

			.invoices-table th.sortable {
				cursor: pointer;
				user-select: none;
			}

			.invoices-table th.sortable:hover {
				color: var(--red);
			}

			.invoices-table th .sort-arrow {
				margin-left: 0.3rem;
				color: var(--red);
			}

			.invoices-table td {
				padding: 0.5rem;
				border-bottom: 1px solid var(--rule);
			}

			.invoices-table tbody tr {
				transition: background 150ms var(--ease);
			}

			.invoices-table tbody tr:hover {
				background: var(--red-soft);
			}

			.invoices-table td.amount {
				font-family: var(--font-mono);
			}

			.badge {
				display: inline-block;
				padding: 0.15rem 0.5rem;
				font-family: var(--font-mono);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				font-size: 0.7rem;
				font-weight: 500;
			}

			.badge-confirmed {
				background: var(--red-soft);
				border: 1px solid var(--red);
				color: var(--red);
			}

			.badge-needs_review {
				background: transparent;
				border: 1px solid var(--rule);
				color: var(--ink-soft);
			}

			.download-btn {
				font-family: var(--font-mono);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				font-size: 0.7rem;
				background: transparent;
				border: 1px solid var(--rule);
				padding: 0.3rem 0.6rem;
				cursor: pointer;
				color: var(--red);
				transition: border-color 150ms var(--ease);
			}

			.download-btn:hover {
				border-color: var(--red);
			}

			.settings-row {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.text-input {
				font-family: var(--font-body);
				font-size: 0.9rem;
				padding: 0.5rem 0.75rem;
				background: var(--paper-raised);
				border: 1px solid var(--rule);
				color: var(--ink);
				min-width: 260px;
				flex: 1;
			}

			.text-input:focus {
				outline: none;
				border-color: var(--red);
			}

			.forward-now-row {
				margin-top: 0.75rem;
			}

			.forward-period-input {
				min-width: 160px;
				flex: 0 1 auto;
			}
		</style>

		<script>
			import { supabase, API_BASE_URL } from '../lib/supabase';

			interface Invoice {
				id: string;
				vendor: string | null;
				amount: number | null;
				currency: string | null;
				invoice_date: string | null;
				status: 'confirmed' | 'needs_review';
				storage_path: string | null;
			}

			const {
				data: { session },
			} = await supabase.auth.getSession();

			if (!session) {
				location.replace('/login');
			} else {
				document.getElementById('user-email')!.textContent = session.user.email ?? '';

				document.getElementById('sign-out-btn')!.addEventListener('click', async () => {
					await supabase.auth.signOut();
					location.replace('/login');
				});

				const gmailPanel = document.getElementById('gmail-panel')!;
				const gmailStatusDot = document.getElementById('gmail-status-dot')!;
				const gmailStatusText = document.getElementById('gmail-status-text')!;
				const gmailMessageEl = document.getElementById('gmail-message')!;
				const gmailConnectBtn = document.getElementById('gmail-connect-btn')!;
				const scanBtn = document.getElementById('scan-btn')!;
				const scanSummaryEl = document.getElementById('scan-summary')!;
				const totalsCurrencyEl = document.getElementById('totals-currency')!;
				const totalsMonthEl = document.getElementById('totals-month')!;
				const invoicesEmptyEl = document.getElementById('invoices-empty')!;
				const invoicesTbody = document.getElementById('invoices-tbody')!;
				const monthChipsEl = document.getElementById('month-chips')!;
				const vendorSearchInput = document.getElementById('vendor-search') as HTMLInputElement;
				const invoicesSummaryEl = document.getElementById('invoices-summary')!;
				const accountantEmailInput = document.getElementById('accountant-email-input') as HTMLInputElement;
				const accountantEmailSaveBtn = document.getElementById('accountant-email-save-btn') as HTMLButtonElement;
				const accountantEmailMessageEl = document.getElementById('accountant-email-message')!;
				const forwardNowRow = document.getElementById('forward-now-row')!;
				const forwardPeriodInput = document.getElementById('forward-period-input') as HTMLInputElement;
				const forwardNowBtn = document.getElementById('forward-now-btn') as HTMLButtonElement;
				const forwardNowMessageEl = document.getElementById('forward-now-message')!;

				type SortColumn = 'vendor' | 'amount' | 'invoice_date';

				let allInvoices: Invoice[] = [];
				let selectedMonth = 'all';
				let searchQuery = '';
				let sortColumn: SortColumn = 'invoice_date';
				let sortDirection: 'asc' | 'desc' = 'desc';

				const gmailParam = new URLSearchParams(location.search).get('gmail');
				if (gmailParam) {
					const messages: Record<string, string> = {
						connected: 'Gmail connected successfully.',
						denied: 'Gmail connection was cancelled.',
						error: 'Gmail connection failed. Please try again.',
					};
					gmailMessageEl.textContent = messages[gmailParam] ?? '';
					gmailMessageEl.style.display = 'block';
					history.replaceState(null, '', location.pathname);
				}

				async function refreshGmailStatus() {
					try {
						const res = await fetch(`${API_BASE_URL}/api/gmail/status`, {
							headers: { Authorization: `Bearer ${session.access_token}` },
						});
						const body = await res.json();
						if (body.connected) {
							gmailStatusDot.classList.add('connected');
							gmailStatusText.textContent = `Gmail connected since ${new Date(body.connectedAt).toLocaleDateString()}`;
							gmailConnectBtn.style.display = 'none';
							scanBtn.style.display = 'inline-block';
							gmailPanel.classList.add('is-connected');
						} else {
							gmailStatusDot.classList.remove('connected');
							gmailStatusText.textContent = 'Gmail not connected.';
							gmailConnectBtn.style.display = 'inline-block';
							scanBtn.style.display = 'none';
							gmailPanel.classList.remove('is-connected');
						}
					} catch (err) {
						gmailStatusText.textContent = `Failed to load Gmail status: ${(err as Error).message}`;
					}
				}

				gmailConnectBtn.addEventListener('click', async () => {
					const res = await fetch(`${API_BASE_URL}/api/gmail/connect`, {
						headers: { Authorization: `Bearer ${session.access_token}` },
					});
					const body = await res.json();
					if (body.url) location.href = body.url;
				});

				function formatAmount(amount: number, currency: string): string {
					return `${amount.toFixed(2)} ${currency}`;
				}

				function computeTotals(invoices: Invoice[]) {
					const byCurrency = new Map<string, number>();
					const byMonthCurrency = new Map<string, Map<string, number>>();

					for (const inv of invoices) {
						if (inv.amount == null || !inv.currency) continue; // incomplete rows never contribute
						byCurrency.set(inv.currency, (byCurrency.get(inv.currency) ?? 0) + inv.amount);

						if (inv.invoice_date) {
							const month = inv.invoice_date.slice(0, 7);
							if (!byMonthCurrency.has(month)) byMonthCurrency.set(month, new Map());
							const monthMap = byMonthCurrency.get(month)!;
							monthMap.set(inv.currency, (monthMap.get(inv.currency) ?? 0) + inv.amount);
						}
					}

					return { byCurrency, byMonthCurrency };
				}

				function renderTotals(invoices: Invoice[]) {
					const { byCurrency, byMonthCurrency } = computeTotals(invoices);

					totalsCurrencyEl.innerHTML = '';
					if (byCurrency.size === 0) {
						const empty = document.createElement('p');
						empty.className = 'muted';
						empty.textContent = 'No confirmed spend yet.';
						totalsCurrencyEl.appendChild(empty);
					} else {
						for (const [currency, total] of byCurrency) {
							const tile = document.createElement('div');
							tile.className = 'stat-tile';

							const currencyLabel = document.createElement('span');
							currencyLabel.className = 'currency';
							currencyLabel.textContent = currency;
							tile.appendChild(currencyLabel);

							const amountLabel = document.createElement('span');
							amountLabel.className = 'amount';
							amountLabel.textContent = formatAmount(total, currency);
							tile.appendChild(amountLabel);

							totalsCurrencyEl.appendChild(tile);
						}
					}

					totalsMonthEl.innerHTML = '';
					const months = [...byMonthCurrency.keys()].sort().reverse();
					if (months.length === 0) {
						const li = document.createElement('li');
						li.className = 'muted';
						li.textContent = 'Nothing to show yet.';
						totalsMonthEl.appendChild(li);
					} else {
						for (const month of months) {
							const li = document.createElement('li');

							const monthLabel = document.createElement('span');
							monthLabel.className = 'month-label';
							monthLabel.textContent = month;
							li.appendChild(monthLabel);

							const amountsLabel = document.createElement('span');
							amountsLabel.className = 'month-amounts';
							const monthMap = byMonthCurrency.get(month)!;
							amountsLabel.textContent = [...monthMap.entries()]
								.map(([currency, total]) => formatAmount(total, currency))
								.join(' · ');
							li.appendChild(amountsLabel);

							totalsMonthEl.appendChild(li);
						}
					}
				}

				function getFilteredSortedInvoices(): Invoice[] {
					let list = allInvoices;

					if (selectedMonth !== 'all') {
						list = list.filter((inv) => inv.invoice_date?.slice(0, 7) === selectedMonth);
					}

					if (searchQuery) {
						const q = searchQuery.toLowerCase();
						list = list.filter((inv) => (inv.vendor ?? '').toLowerCase().includes(q));
					}

					return [...list].sort((a, b) => {
						let cmp = 0;
						if (sortColumn === 'vendor') {
							cmp = (a.vendor ?? '').localeCompare(b.vendor ?? '');
						} else if (sortColumn === 'amount') {
							cmp = (a.amount ?? -Infinity) - (b.amount ?? -Infinity);
						} else {
							cmp = (a.invoice_date ?? '').localeCompare(b.invoice_date ?? '');
						}
						return sortDirection === 'asc' ? cmp : -cmp;
					});
				}

				function renderMonthChips() {
					const months = [
						...new Set(
							allInvoices.map((inv) => inv.invoice_date?.slice(0, 7)).filter((m): m is string => !!m)
						),
					]
						.sort()
						.reverse();

					// A rescan can drop the month currently selected in the UI; fall back
					// to "all" rather than silently filtering against a month that no
					// longer exists in the data.
					if (selectedMonth !== 'all' && !months.includes(selectedMonth)) {
						selectedMonth = 'all';
					}

					monthChipsEl.innerHTML = '';

					const allChip = document.createElement('button');
					allChip.type = 'button';
					allChip.className = 'month-chip' + (selectedMonth === 'all' ? ' active' : '');
					allChip.textContent = 'All';
					allChip.dataset.month = 'all';
					monthChipsEl.appendChild(allChip);

					for (const month of months) {
						const chip = document.createElement('button');
						chip.type = 'button';
						chip.className = 'month-chip' + (selectedMonth === month ? ' active' : '');
						chip.textContent = month;
						chip.dataset.month = month;
						monthChipsEl.appendChild(chip);
					}
				}

				function updateSortHeaders() {
					document.querySelectorAll<HTMLElement>('.invoices-table th.sortable').forEach((th) => {
						th.querySelector('.sort-arrow')?.remove();
						if (th.dataset.sort === sortColumn) {
							const arrow = document.createElement('span');
							arrow.className = 'sort-arrow';
							arrow.textContent = sortDirection === 'asc' ? '▲' : '▼';
							th.appendChild(arrow);
						}
					});
				}

				function renderInvoicesSummary(filtered: Invoice[]) {
					if (filtered.length === 0) {
						invoicesSummaryEl.textContent = '';
						return;
					}
					const { byCurrency } = computeTotals(filtered);
					const totalsText = [...byCurrency.entries()]
						.map(([currency, total]) => formatAmount(total, currency))
						.join(' · ');
					const invoiceWord = filtered.length === 1 ? 'invoice' : 'invoices';
					invoicesSummaryEl.textContent = totalsText
						? `${filtered.length} ${invoiceWord} · ${totalsText}`
						: `${filtered.length} ${invoiceWord}`;
				}

				function applyFiltersAndRender() {
					renderMonthChips();
					updateSortHeaders();
					const filtered = getFilteredSortedInvoices();
					renderInvoicesSummary(filtered);
					renderTable(filtered);
				}

				monthChipsEl.addEventListener('click', (event) => {
					const target = (event.target as HTMLElement).closest('.month-chip') as HTMLButtonElement | null;
					if (!target) return;
					selectedMonth = target.dataset.month!;
					applyFiltersAndRender();
				});

				let searchDebounce: ReturnType<typeof setTimeout> | undefined;
				vendorSearchInput.addEventListener('input', () => {
					clearTimeout(searchDebounce);
					searchDebounce = setTimeout(() => {
						searchQuery = vendorSearchInput.value.trim();
						applyFiltersAndRender();
					}, 150);
				});

				document.querySelectorAll<HTMLElement>('.invoices-table th.sortable').forEach((th) => {
					th.addEventListener('click', () => {
						const col = th.dataset.sort as SortColumn;
						if (sortColumn === col) {
							sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
						} else {
							sortColumn = col;
							sortDirection = col === 'vendor' ? 'asc' : 'desc';
						}
						applyFiltersAndRender();
					});
				});

				function renderInvoiceRow(invoice: Invoice): HTMLTableRowElement {
					const tr = document.createElement('tr');

					const vendorCell = document.createElement('td');
					vendorCell.textContent = invoice.vendor ?? '(unknown)';
					tr.appendChild(vendorCell);

					const amountCell = document.createElement('td');
					amountCell.className = 'amount';
					amountCell.textContent =
						invoice.amount != null && invoice.currency ? formatAmount(invoice.amount, invoice.currency) : '—';
					tr.appendChild(amountCell);

					const dateCell = document.createElement('td');
					dateCell.textContent = invoice.invoice_date ?? '—';
					tr.appendChild(dateCell);

					const statusCell = document.createElement('td');
					const badge = document.createElement('span');
					badge.className = `badge badge-${invoice.status}`;
					badge.textContent = invoice.status === 'confirmed' ? 'Confirmed' : 'Needs review';
					statusCell.appendChild(badge);
					tr.appendChild(statusCell);

					const actionCell = document.createElement('td');
					if (invoice.storage_path) {
						const downloadBtn = document.createElement('button');
						downloadBtn.textContent = 'Download';
						downloadBtn.className = 'download-btn';
						downloadBtn.dataset.invoiceId = invoice.id;
						actionCell.appendChild(downloadBtn);
					}
					tr.appendChild(actionCell);

					return tr;
				}

				function renderTable(invoices: Invoice[]) {
					invoicesTbody.innerHTML = '';
					if (invoices.length === 0) {
						invoicesEmptyEl.textContent =
							allInvoices.length === 0
								? 'No invoices yet — click "Scan & save invoices" to get started.'
								: 'No invoices match your filters.';
						invoicesEmptyEl.style.display = 'block';
						document.getElementById('invoices-table')!.style.display = 'none';
						return;
					}
					invoicesEmptyEl.style.display = 'none';
					document.getElementById('invoices-table')!.style.display = 'table';
					for (const invoice of invoices) {
						invoicesTbody.appendChild(renderInvoiceRow(invoice));
					}
				}

				// Delegated listener: one handler for every download button,
				// including ones added by future re-renders after a scan.
				invoicesTbody.addEventListener('click', async (event) => {
					const target = (event.target as HTMLElement).closest('.download-btn') as HTMLButtonElement | null;
					if (!target) return;
					const invoiceId = target.dataset.invoiceId;
					const originalText = target.textContent;
					target.textContent = 'Loading…';
					target.disabled = true;
					try {
						const res = await fetch(`${API_BASE_URL}/api/invoices/${invoiceId}/download`, {
							headers: { Authorization: `Bearer ${session.access_token}` },
						});
						const body = await res.json();
						if (body.url) {
							window.open(body.url, '_blank');
						} else {
							target.textContent = 'Failed';
							setTimeout(() => {
								target.textContent = originalText;
							}, 2000);
						}
					} catch (err) {
						target.textContent = 'Failed';
						setTimeout(() => {
							target.textContent = originalText;
						}, 2000);
					} finally {
						target.disabled = false;
						if (target.textContent === 'Loading…') target.textContent = originalText;
					}
				});

				function defaultForwardPeriod(): string {
					const d = new Date();
					d.setUTCDate(1);
					d.setUTCMonth(d.getUTCMonth() - 1);
					return d.toISOString().slice(0, 7);
				}

				// No accountant_email set = forwarding is off for this user; hiding the
				// button here mirrors the server-side check in /api/forward/now (which
				// rejects the request either way — this is just so the UI doesn't offer
				// an action that would 400).
				function updateForwardNowVisibility() {
					forwardNowRow.style.display = accountantEmailInput.value.trim() ? 'flex' : 'none';
				}

				async function loadAccountantEmail() {
					try {
						const res = await fetch(`${API_BASE_URL}/api/me`, {
							headers: { Authorization: `Bearer ${session.access_token}` },
						});
						const body = await res.json();
						accountantEmailInput.value = body.accountantEmail ?? '';
					} catch (err) {
						// Non-fatal: field just stays blank; save still works from a clean input.
					} finally {
						updateForwardNowVisibility();
					}
				}

				accountantEmailSaveBtn.addEventListener('click', async () => {
					const value = accountantEmailInput.value.trim();
					accountantEmailSaveBtn.disabled = true;
					accountantEmailMessageEl.style.display = 'none';
					try {
						const res = await fetch(`${API_BASE_URL}/api/me`, {
							method: 'PATCH',
							headers: {
								Authorization: `Bearer ${session.access_token}`,
								'Content-Type': 'application/json',
							},
							body: JSON.stringify({ accountantEmail: value || null }),
						});
						const body = await res.json();
						accountantEmailMessageEl.style.display = 'block';
						accountantEmailMessageEl.classList.remove('has-errors', 'success');
						if (!res.ok) {
							accountantEmailMessageEl.classList.add('has-errors');
							accountantEmailMessageEl.textContent = body.message || body.error || 'Failed to save.';
						} else {
							accountantEmailMessageEl.classList.add('success');
							accountantEmailMessageEl.textContent = value ? 'Saved.' : 'Forwarding disabled.';
						}
					} catch (err) {
						accountantEmailMessageEl.style.display = 'block';
						accountantEmailMessageEl.classList.remove('success');
						accountantEmailMessageEl.classList.add('has-errors');
						accountantEmailMessageEl.textContent = `Failed to save: ${(err as Error).message}`;
					} finally {
						accountantEmailSaveBtn.disabled = false;
						updateForwardNowVisibility();
					}
				});

				forwardPeriodInput.value = defaultForwardPeriod();

				forwardNowBtn.addEventListener('click', async () => {
					const period = forwardPeriodInput.value;
					if (!period) return;
					forwardNowBtn.disabled = true;
					forwardNowMessageEl.style.display = 'none';
					try {
						const res = await fetch(`${API_BASE_URL}/api/forward/now`, {
							method: 'POST',
							headers: {
								Authorization: `Bearer ${session.access_token}`,
								'Content-Type': 'application/json',
							},
							body: JSON.stringify({ period }),
						});
						const body = await res.json();
						forwardNowMessageEl.style.display = 'block';
						forwardNowMessageEl.classList.remove('has-errors', 'success');
						if (body.status === 'sent') {
							forwardNowMessageEl.classList.add('success');
							forwardNowMessageEl.textContent = `Sent digest for ${period} (${body.count} invoice${body.count === 1 ? '' : 's'}).`;
						} else if (body.status === 'already_sent') {
							// Not an error — the safety rule working as intended, so this gets
							// neutral styling rather than the red has-errors banner.
							forwardNowMessageEl.textContent = body.message;
						} else if (body.status === 'no_invoices') {
							forwardNowMessageEl.textContent = body.message;
						} else {
							forwardNowMessageEl.classList.add('has-errors');
							forwardNowMessageEl.textContent = body.message || body.error || 'Failed to forward.';
						}
					} catch (err) {
						forwardNowMessageEl.style.display = 'block';
						forwardNowMessageEl.classList.remove('success');
						forwardNowMessageEl.classList.add('has-errors');
						forwardNowMessageEl.textContent = `Failed to forward: ${(err as Error).message}`;
					} finally {
						forwardNowBtn.disabled = false;
					}
				});

				async function loadInvoices() {
					const res = await fetch(`${API_BASE_URL}/api/invoices`, {
						headers: { Authorization: `Bearer ${session.access_token}` },
					});
					const body = await res.json();
					allInvoices = body.invoices ?? [];
					renderTotals(allInvoices);
					applyFiltersAndRender();
				}

				scanBtn.addEventListener('click', async () => {
					scanSummaryEl.style.display = 'block';
					scanSummaryEl.classList.remove('has-errors');
					scanSummaryEl.textContent = 'Scanning… (this can take a while)';
					(scanBtn as HTMLButtonElement).disabled = true;
					try {
						const res = await fetch(`${API_BASE_URL}/api/gmail/scan`, {
							method: 'POST',
							headers: {
								Authorization: `Bearer ${session.access_token}`,
								'Content-Type': 'application/json',
							},
							body: JSON.stringify({}),
						});
						const body = await res.json();
						if (!res.ok) {
							scanSummaryEl.classList.add('has-errors');
							scanSummaryEl.textContent = body.message || body.error || 'Scan failed.';
						} else {
							scanSummaryEl.textContent = `Scanned ${body.count} messages: ${body.saved} saved, ${body.skippedDuplicate} already saved, ${body.skippedNotInvoice} not invoices, ${body.skippedNoPdf} no PDF, ${body.errors} errors.`;
							if (body.errors > 0) scanSummaryEl.classList.add('has-errors');
							await loadInvoices();
						}
					} catch (err) {
						scanSummaryEl.classList.add('has-errors');
						scanSummaryEl.textContent = `Scan failed: ${(err as Error).message}`;
					} finally {
						(scanBtn as HTMLButtonElement).disabled = false;
					}
				});

				await loadInvoices();
				await refreshGmailStatus();
				await loadAccountantEmail();
			}
		</script>
	</body>
</html>
